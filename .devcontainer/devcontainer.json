{
  "name": "Python 3.12",
  "image": "mcr.microsoft.com/devcontainers/python:3.12-bookworm",
  "remoteUser": "vscode",
  "forwardPorts": [
  ],
  "portsAttributes": {
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "streetsidesoftware.code-spell-checker",
        "ms-toolsai.jupyter",
        "github.vscode-github-actions"
      ]
    }
  },
  "postCreateCommand": "pip install --user requirements.txt"
}